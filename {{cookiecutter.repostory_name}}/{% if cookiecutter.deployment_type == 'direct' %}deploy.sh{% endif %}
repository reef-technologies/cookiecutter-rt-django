set -eux

if [ ! -f ".env" ]; then
    echo "\e[31mPlease setup the environment first!\e[0m";
    exit 1;
fi

GIT_SHA=$(git rev-parse --short HEAD 2>/dev/null || printf "%s" "unknown")
export GIT_SHA

docker compose build --pull --build-arg GIT_SHA="$GIT_SHA"
docker compose pull --ignore-buildable

docker compose up -d db  # in case it hasn't been launched before
# backup db before any database changes
docker compose run --rm backups ./backup-db.sh

# collect static files to external storage while old app is still running
# docker compose run --rm app sh -c "python manage.py collectstatic --no-input"

# Stop app/celery services before migrations to avoid schema mismatches
SERVICES=$(docker compose ps --services 2>/dev/null | grep -E '^(app|celery-worker|celery-beat)$' || true)
if [ -n "$SERVICES" ]; then
    # shellcheck disable=2086
    docker compose stop $SERVICES
fi
# start the app container only in order to perform migrations
docker compose run --rm app sh -c "python manage.py wait_for_database --timeout 10; python manage.py migrate"
{% if cookiecutter.monitoring %}
docker compose run --rm app sh prometheus-cleanup.sh
{% endif %}

# start everything; drop containers of services removed from docker-compose.yml
docker compose up -d --remove-orphans

# nginx resolves upstream container names once at config load; containers
# recreated above (e.g. postgres-exporter) get new IPs, so re-resolve
docker compose exec nginx nginx -s reload || true

# Reclaim disk space; a failed cleanup never fails the deploy. Builds keep
# reusing the cache they need, so anything unused for 3 days is stale.
PRUNE_UNTIL="until=72h"
# build cache: layers no build has used for 3 days (old dependency and frontend layers)
docker builder prune -f --filter "$PRUNE_UNTIL" || true
# images no container uses, created over 3 days ago: earlier app builds, one-off pulls
docker image prune -af --filter "$PRUNE_UNTIL" || true
