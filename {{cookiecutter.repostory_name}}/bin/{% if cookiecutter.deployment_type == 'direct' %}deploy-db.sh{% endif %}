#!/bin/bash
# Called by deploy.sh: starts `db`, first upgrading it to the configured PostgreSQL major
# when its data is older, and recovering when an upgrade fails or an earlier one was
# interrupted. See README.md, "Upgrading PostgreSQL".
set -euo pipefail

cd "$(dirname "$0")/.."

db_upgrade() {
    docker compose run --rm --no-deps -T db-upgrade "$@"
}

# everything that may use the database stays stopped until it is upgraded or recovered
stopped=
stop_db_clients() {
    stopped=$(docker compose ps --services --status running | grep -vx db || true)
    if [ -n "$stopped" ]; then
        # shellcheck disable=SC2086
        docker compose stop $stopped
    fi
}

state=0
db_upgrade check || state=$?
case "$state" in
    0) ;;
    10)
        if ! docker compose ps --services --status running | grep -qx db; then
            echo "ERROR: a PostgreSQL upgrade is pending, but the db service is not running, so no backup can be taken from the old version." >&2
            echo "Start the old version (check out the previous commit and run \`docker compose up -d db\`), then deploy again." >&2
            exit 1
        fi
        stop_db_clients
        echo "Backing up the database before the upgrade"
        # the reference is the last line; `run` may print image build output before it
        if ! ref=$(docker compose run --rm --no-deps -T backups ./backup-db-ref.sh | tail -n 1) || ! db_upgrade mark-backup "$ref"; then
            echo "ERROR: the pre-upgrade backup failed; nothing was upgraded." >&2
            if [ -n "$stopped" ]; then
                # shellcheck disable=SC2086
                docker compose start $stopped
            fi
            exit 1
        fi
        docker compose stop db
        ;;
    20)
        stop_db_clients
        bin/db-recover.sh
        ;;
    *) exit 1 ;;
esac

if ! docker compose up -d db; then
    state=0
    db_upgrade check || state=$?
    if [ "$state" -ne 20 ]; then
        exit 1
    fi
    bin/db-recover.sh
fi
